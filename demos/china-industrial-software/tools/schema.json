{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "China Industrial Software Survey Data",
  "definitions": {
    "source": {
      "type": "object",
      "required": ["url", "publisher", "publisher_domain", "publisher_ownership", "support_scope"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "title": { "type": "string" },
        "label_zh": { "type": "string", "minLength": 1 },
        "label_en": { "type": "string", "minLength": 1 },
        "accessed": { "type": "string", "pattern": "^\\d{4}-\\d{2}(-\\d{2})?$" },
        "publisher": { "type": "string", "minLength": 1 },
        "publisher_domain": { "type": "string", "minLength": 1 },
        "publisher_ownership": { "type": "string", "enum": ["external"] },
        "support_scope": {
          "type": "string",
          "enum": ["entity_identity", "claim_evidence", "candidate_lead"]
        }
      },
      "additionalProperties": false
    },
    "breakthrough": {
      "type": "object",
      "required": ["year", "text_zh"],
      "properties": {
        "year": { "type": "integer", "minimum": 1990, "maximum": 2030 },
        "text_zh": { "type": "string", "minLength": 1 },
        "text_en": { "type": "string" },
        "source_url": { "type": "string" },
        "source_publisher": { "type": "string", "minLength": 1 },
        "source_publisher_domain": { "type": "string", "minLength": 1 },
        "source_publisher_ownership": { "type": "string", "enum": ["external"] },
        "source_support_scope": { "type": "string", "enum": ["candidate_lead"] }
      },
      "additionalProperties": false
    },
    "milestone_metric": {
      "type": "object",
      "required": ["label_zh", "value"],
      "properties": {
        "label_zh": { "type": "string" },
        "label_en": { "type": "string" },
        "value": { "type": "string" },
        "verified": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "milestone": {
      "type": "object",
      "required": [
        "id", "date", "vendor_id", "category_l2",
        "headline_zh", "headline_en",
        "before_gap_zh", "before_gap_en",
        "achievement_zh", "achievement_en",
        "still_missing_zh", "still_missing_en",
        "evidence_level", "sources", "confidence"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}(-\\d{2})?$" },
        "date_precision": { "type": "string", "enum": ["year", "month", "day"] },
        "vendor_id": { "type": "string" },
        "product_ids": { "type": "array", "items": { "type": "string" } },
        "incumbent_product_ids": { "type": "array", "items": { "type": "string" } },
        "incumbent_examples": { "type": "array", "items": { "type": "string" } },
        "capability_key": { "type": "string" },
        "category_l2": { "type": "string" },
        "headline_zh": { "type": "string", "minLength": 1 },
        "headline_en": { "type": "string", "minLength": 1 },
        "before_gap_zh": { "type": "string", "minLength": 1 },
        "before_gap_en": { "type": "string", "minLength": 1 },
        "achievement_zh": { "type": "string", "minLength": 1 },
        "achievement_en": { "type": "string", "minLength": 1 },
        "still_missing_zh": { "type": "string", "minLength": 1 },
        "still_missing_en": { "type": "string", "minLength": 1 },
        "metrics": { "type": "array", "items": { "$ref": "#/definitions/milestone_metric" } },
        "evidence_level": {
          "type": "string",
          "enum": ["audited", "case_study", "vendor_claim", "media", "candidate"]
        },
        "sources": { "type": "array", "items": { "$ref": "#/definitions/source" }, "minItems": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "related_policy_ids": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "market_share": {
      "type": "object",
      "properties": {
        "value": { "type": "number", "minimum": 0, "maximum": 100 },
        "year": { "type": "integer" },
        "source_url": { "type": "string" },
        "note_zh": { "type": "string" },
        "note_en": { "type": "string" }
      },
      "additionalProperties": false
    },
    "product": {
      "type": "object",
      "required": [
        "id", "name_zh", "name_en", "vendor_id",
        "category_l1", "category_l2", "origin",
        "kernel", "maturity", "localization_depth",
        "strengths_zh", "strengths_en", "limitations_zh", "limitations_en",
        "industries", "pricing", "confidence", "sources"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "name_zh": { "type": "string", "minLength": 1 },
        "name_en": { "type": "string", "minLength": 1 },
        "vendor_id": { "type": "string", "minLength": 1 },
        "category_l1": {
          "type": "string",
          "enum": ["研发设计", "生产制造", "经营管理", "运维服务", "基础平台"]
        },
        "product_type": {
          "type": "string",
          "enum": [
            "mcad", "2d_cad", "dcc_mesh", "cae_solver", "cam", "eda", "plm",
            "bim", "bim_coordination", "reality_capture", "gis", "iiot_platform",
            "scada", "mes", "dcs", "eam", "erp", "slicer", "cim", "mbse",
            "cad_interop", "cad_automation", "other"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "digital_twin", "xinchuang", "am_slicing", "cad_interop",
              "open_source_stack", "semiconductor", "aerospace", "automotive",
              "cloud_native", "low_code", "clash_detection", "federated_bim",
              "point_cloud", "model_checking", "4d_simulation", "open_bim",
              "visual_programming", "cad_scripting"
            ]
          },
          "uniqueItems": true
        },
        "category_l2": { "type": "string", "minLength": 1 },
        "taxonomy_note_zh": { "type": "string", "minLength": 1 },
        "taxonomy_note_en": { "type": "string", "minLength": 1 },
        "subsegment": { "type": "string", "minLength": 1 },
        "capabilities": {
          "type": "object",
          "required": ["full", "partial"],
          "properties": {
            "full": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
            "partial": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
          },
          "additionalProperties": false
        },
        "origin": {
          "type": "string",
          "enum": ["domestic", "joint_venture", "international", "open_source"]
        },
        "kernel": { "type": "string" },
        "kernel_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "maturity": {
          "type": "string",
          "enum": ["experimental", "mid", "high", "mission_critical"]
        },
        "localization_depth": {
          "type": "string",
          "enum": ["none", "pilot", "partial", "core"]
        },
        "market_share_cn": { "$ref": "#/definitions/market_share" },
        "international_benchmarks": {
          "type": "array",
          "items": { "type": "string" }
        },
        "strengths_zh": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "strengths_en": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "limitations_zh": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "limitations_en": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "breakthroughs": {
          "type": "array",
          "items": { "$ref": "#/definitions/breakthrough" }
        },
        "industries": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "pricing": {
          "type": "string",
          "enum": ["free", "low", "mid", "high", "quote"]
        },
        "listed_ticker": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "last_verified": { "type": "string", "pattern": "^\\d{4}-\\d{2}(-\\d{2})?$" },
        "sources": {
          "type": "array",
          "items": { "$ref": "#/definitions/source" },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "kernel": {
      "type": "object",
      "required": [
        "id", "name_zh", "name_en", "owner", "origin", "license_model",
        "capabilities_zh", "capabilities_en",
        "strengths_zh", "strengths_en",
        "limitations_zh", "limitations_en",
        "used_by_product_ids", "used_by_international", "chinese_products_using",
        "substitution_status_zh", "substitution_status_en",
        "domestic_alternatives", "confidence", "sources"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "name_zh": { "type": "string", "minLength": 1 },
        "name_en": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "origin": { "type": "string", "enum": ["international", "domestic", "open_source"] },
        "license_model": {
          "type": "string",
          "enum": ["commercial", "oem", "open_source", "proprietary_inhouse"]
        },
        "first_release_year": { "type": ["integer", "null"], "minimum": 1970, "maximum": 2030 },
        "capabilities_zh": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "capabilities_en": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "strengths_zh": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "strengths_en": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "limitations_zh": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "limitations_en": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "used_by_product_ids": { "type": "array", "items": { "type": "string" } },
        "used_by_domestic": { "type": "array", "items": { "type": "string" } },
        "used_by_international": { "type": "array", "items": { "type": "string" } },
        "chinese_products_using": { "type": "array", "items": { "type": "string" } },
        "substitution_status_zh": { "type": "string", "minLength": 1 },
        "substitution_status_en": { "type": "string", "minLength": 1 },
        "domestic_alternatives": { "type": "array", "items": { "type": "string" } },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "sources": {
          "type": "array",
          "items": { "$ref": "#/definitions/source" },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "vendor": {
      "type": "object",
      "required": ["id", "name_zh", "name_en", "origin", "hq_city"],
      "properties": {
        "id": { "type": "string" },
        "name_zh": { "type": "string" },
        "name_en": { "type": "string" },
        "origin": { "type": "string", "enum": ["domestic", "joint_venture", "international"] },
        "hq_city": { "type": "string" },
        "hq_country": { "type": "string" },
        "listed_ticker": { "type": "string" },
        "website": { "type": "string" },
        "description_zh": { "type": "string" },
        "description_en": { "type": "string" },
        "categories": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "products": {
      "type": "array",
      "items": { "$ref": "#/definitions/product" }
    },
    "vendors": {
      "type": "array",
      "items": { "$ref": "#/definitions/vendor" }
    }
  }
}
