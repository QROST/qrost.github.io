{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qrost.github.io/demos/china-auto/tools/schema.json",
  "title": "China Auto City Atlas — entity schemas",
  "description": "V1 knowledge-graph contracts. Bilingual fields use *_zh / *_en. Every evidence-bearing row carries confidence and source_ids; confidence above 0.5 requires linked external evidence.",
  "provenance_policy": {
    "candidate_max_confidence": 0.5,
    "external_evidence_required_above": 0.5,
    "source_url_schemes": ["http", "https"],
    "self_authored_sources_allowed": false,
    "publisher_ownership_required": "external",
    "publisher_domain_must_match_url": true,
    "support_scope_required": true
  },
  "source_contract": {
    "required": [
      "publisher_zh",
      "publisher_en",
      "publisher_domain",
      "publisher_ownership",
      "support_scope"
    ],
    "support_scope_required": ["entity_refs", "fields", "scope_zh", "scope_en"],
    "support_scope_semantics": "Each entity_ref must resolve to a row that links this source_id. Every declared field must exist on that row."
  },
  "enums": {
    "admin_level": ["municipality", "prefecture", "county", "cooperation_zone"],
    "city_tier": ["core", "specialist"],
    "role_tag": [
      "oem_manufacturing",
