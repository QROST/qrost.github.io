      "software_company",
      "chip_company",
      "research_institute",
      "university",
      "media_company",
      "industry_association",
      "testing_body"
    ],
    "org_status": ["active", "planned", "paused", "closed", "unknown"],
    "facility_type": [
      "headquarters_campus",
      "vehicle_plant",
      "engine_plant",
      "battery_plant",
      "parts_plant",
      "rd_center",
      "design_center",
      "testing_center",
      "port_terminal"
    ],
    "facility_status": [
      "active",
      "planned",
      "under_construction",
      "paused",
      "closed",
      "converted",
      "unknown"
    ],
    "role_type": [
      "headquarters",
