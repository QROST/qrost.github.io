      "rd_design",
      "autonomous_driving",
      "auto_software",
      "chips",
      "battery",
      "auto_electronics",
      "parts",
      "testing",
      "higher_education",
      "auto_media",
      "expo_culture",
      "export_logistics",
      "auto_history"
    ],
    "organization_type": [
      "automaker",
