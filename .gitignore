Chat.md
.DS_Store
__pycache__/
*.pyc

# Node.js — per-demo Tailwind/tooling installs (built CSS is committed under assets/css/)
# ** so this also catches nested installs like demos/china-housing/tools/node_modules/
# (a single * stops at the next path segment and previously let that one slip through).
demos/**/node_modules/
demos/**/package-lock.json

# Python virtualenv (china-housing pm25 tooling, etc.)
.venv/

# SQLite WAL mode sidecars (runtime only; never commit)
*.db-shm
*.db-wal

# china-housing: the ONLY DB is demos/china-housing/data/housing.db (single source of truth).
# Guard against stray empty DBs from scripts run with a wrong path/name (anchored, so the
# canonical data/housing.db stays tracked):
/demos/china-housing/housing.db
demos/china-housing/china_housing.db
demos/china-housing/data/china_housing.db

# --- china-housing: process / working artifacts (keep on disk, not in git) ---
# Agent batch CSVs + one-off import sheets
demos/china-housing/data/batch-*.csv
demos/china-housing/data/import-*.csv
# Parallel agent findings, audit reports, listing research
demos/china-housing/data/research/
demos/china-housing/data/hazard_research.json
# ChinaHighPM2.5 NetCDF/RAR source (~261MB; GitHub blocks >100MB)
demos/china-housing/data/chinahighpm25/
# Resumable climate-daily refresh checkpoint
demos/china-housing/data/.climate_daily_ext.json
# CDS ERA5 bulk NetCDF cache (tools/era5_bulk.py)
demos/china-housing/data/ref/era5/
# Open-Meteo / CDS field-grid fetch caches (NOT static ref: airports/coast/hospitals)
demos/china-housing/data/ref/field_grid*.json
demos/china-housing/data/ref/hist_temp_cache.json
# Download / fetch logs
demos/china-housing/data/ref/*.log
*.log

# --- Local audit / agent scratch (not for public repo) ---
demos/wfoe-china/tmp/
demos/china-industrial-software/tmp/
demos/pharm-companies/tmp/
demos/makoauto/_tmp/

# makoauto: unused raw source-photo dump (site actually serves demos/makoauto/assets/legacy/photos/).
# Purged from history 2026-07-02 — keep this guard so it can't silently regrow.
demos/makoauto/assets/photos/

AGENTS.md
.claude/
